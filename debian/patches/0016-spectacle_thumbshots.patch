+def thumbshot_spectacle(width,height):
+
+	image_path=f"/tmp/{os.environ["USER"]}-epoptes.png"
+	if os.path.exists(image_path):
+		os.remove(image_path)
+
+	width,height=int(sys.argv[1]), int(sys.argv[2])
+		
+	command=f"spectacle -b -n -f -o {image_path}"
+	os.system(command)
+
+	if os.path.exists(image_path):
+		#pixbuf = GdkPixbuf.Pixbuf.new_from_file(image_path)
+		
+		src = cairo.ImageSurface.create_from_png(image_path)
+		src_w , src_h = src.get_width(), src.get_height()
+		
+		dst = cairo.ImageSurface(cairo.FORMAT_RGB24,width,height)
+		ctx = cairo.Context(dst)
+		
+		ctx.scale(width / src_w , height / src_h )
+		ctx.set_source_surface(src,0,0)
+		ctx.get_source().set_filter(cairo.FILTER_BILINEAR)
+		ctx.paint()
+
+		pixbuf = Gdk.pixbuf_get_from_surface(dst, 0, 0, width, height)
+		rowst = pixbuf.get_rowstride()
+		pixels = pixbuf.get_pixels()
+		
+		#sys.stdout.buffer.flush()
+		data = (b"%i\n%ix%i\n" % (rowst, width, height) + pixels  + b"\0"*(rowst*height - len(pixels)))
+		#sys.stdout.buffer.write(data)
+		#sys.stdout.buffer.flush()
+		os.remove(image_path)
+	
+		return data
+
+
 def thumbshot(width, height):
