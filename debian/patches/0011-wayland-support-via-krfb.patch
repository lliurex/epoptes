+    def execute_wl_viewer(self,handle,reply,assist=False):
+
+        clients = self.get_selected_clients()
+        for client in clients:
+            ip=list(client[C_INSTANCE].users)[0].split(":")[0]
+            key=list(client[C_INSTANCE].users)[0]
+            user=client[C_INSTANCE].users[key]["uname"]
+            timeout=5.0
+            while True:
+                s=socket.socket(socket.AF_INET,socket.SOCK_STREAM)
+                ret=s.connect_ex(("%s"%ip,5900))
+                if ret == 0:
+                    break
+                else:
+                    if timeout >0.0:
+                        print("Sleeping. Waiting for krfb to be ready...")
+                        time.sleep(0.5)
+                        timeout-=0.5
+                    else:
+                        break
+            print("vncviewer %s"%time.time())
+            #os.system("sleep 10")
+            assist_mode="" if self.assist else "-ViewOnly"
+            subprocess.Popen(f"vncviewer {ip}:5900 {assist_mode} -geometry 800x600+1920+1080 -passwd /run/epoptes/{user}_access",shell=True)
+            print("vncviewer done %s"%time.time())
