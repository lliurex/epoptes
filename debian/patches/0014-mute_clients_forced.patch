+    def lliurex_mute(self, cmd):
+        """Send mute/unmute to the root client, passing the session user."""
+        clients = self.get_selected_clients()
+        if not clients:  # No client selected, send the command to all
+            clients = self.cstore
+        for client in clients:
+            inst = client[C_INSTANCE]
+            if inst.type == 'offline' or not client[C_SESSION_HANDLE]:
+                continue
+            user = inst.users[client[C_SESSION_HANDLE]]['uname']
+            self.exec_on_clients([cmd, user], [client], mode=EM_SYSTEM)
 
